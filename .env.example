# Production canonical URL
NEXT_PUBLIC_SITE_URL=https://saiprakash.design

# Show draft articles (set to 1 on Vercel *Preview* deployments only)
SHOW_DRAFTS=

# Keystatic: "local" edits files on disk (dev). "github" commits through the GitHub app (production /keystatic).
NEXT_PUBLIC_KEYSTATIC_STORAGE=local
# Filled in automatically when you create the Keystatic GitHub app from /keystatic in dev
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
